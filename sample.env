# LahziCart - Sample Environment Configuration
# Copy this file to each service's .env and adjust as needed

# Common Configuration
APP_NAME=LahziCart
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root

# Service-specific Database Names
# ---------------------------------------------------
# Auth Service
DB_NAME_AUTH=user_auth

# User Service
DB_NAME_USER=user-service

# Catalog Service
DB_NAME_CATALOG=catalog

# Inventory Service
DB_NAME_INVENTORY=inventory

# Cart Service
DB_NAME_CART=cart

# Order Service
DB_NAME_ORDERS=orders

# Payment Service
DB_NAME_PAYMENT=payment

# Notification Service
DB_NAME_NOTIFICATION=notification

# Delivery Service
DB_NAME_DELIVERY=delivery

# Kafka Configuration
KAFKA_BROKERS=localhost:9092

# Auth Service Specific
SECRET_KEY=change-me
REFRESH_KEY=change-me
GRPC_PORT=50051
EXPIRE_IN=100

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Gateway Configuration
# NOTE: the gateway reads PRODUCT_SERVICE_URL (not CATALOG_SERVICE_URL) for the
# catalog service. Every URL below is required by the api-gateway service.
# The gateway also reads REDIS_HOST and REDIS_PORT from its own .env. It uses
# the session state that the auth-service writes, so a revoked token is
# rejected. Without Redis the gateway still starts, but it cannot enforce the
# revocation.
JWT_SECRET=change-me
AUTH_SERVICE_URL=http://localhost:7700
USER_SERVICE_URL=http://localhost:7701
PRODUCT_SERVICE_URL=http://localhost:7702
INVENTORY_SERVICE_URL=http://localhost:7703
CART_SERVICE_URL=http://localhost:7704
ORDER_SERVICE_URL=http://localhost:7705
PAYMENT_SERVICE_URL=http://localhost:7706
NOTIFICATION_SERVICE_URL=http://localhost:7707
DELIVERY_SERVICE_URL=http://localhost:7708
API_PORT=7070