# The API gateway that a device talks to.
EXPO_PUBLIC_API_BASE_URL=http://localhost:7070

# The address that the browser talks to.
#
# The browser cannot call the gateway directly, because the gateway does not
# answer the CORS preflight that the browser sends before a request with a
# body. The development proxy forwards the request to the gateway and adds the
# CORS headers. Start it with "npm run api-proxy", or use "npm run web",
# which starts the proxy and the web server together.
EXPO_PUBLIC_WEB_API_BASE_URL=http://localhost:7071

EXPO_PUBLIC_DEFAULT_CURRENCY=INR
